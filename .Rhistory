packages_needed <- c(
"dplyr",
"ggplot2",
"patchwork",
"plotly",
"rlang",
"janitor",
"tidyr",
"gridExtra",
"testthat"
)
installed_packages <- rownames(installed.packages())
missing_packages <- packages_needed[!packages_needed %in% installed_packages]
if (length(missing_packages) == 0) {
cat("✅ SEMUA PACKAGE SUDAH TERINSTALL!\n")
cat("   Tidak perlu install apapun.\n")
} else {
cat("❌ PACKAGE YANG BELUM TERINSTALL:\n")
for (pkg in missing_packages) {
cat("   -", pkg, "\n")
}
cat("\n📦 Install dengan:\n")
cat("   install.packages(c(", paste0('"', missing_packages, '"', collapse = ", "), "))\n")
}
# Install patchwork
install.packages("patchwork")
