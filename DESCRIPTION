Package: janitorID
Title: Advanced Data Cleaning, Currency Conversion, and Health Visualization Toolkit
Version: 0.1.0
Authors@R: 
    c(
        person("Kelompok", "Data Science 1", 
               email = "janitorid.team@example.com", 
               role = c("aut", "cre"),
